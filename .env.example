# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# NCCI_EMBED_MODEL=text-embedding-3-large
# NCCI_CHAT_MODEL=gpt-4.1
# NCCI_RERANKER=BAAI/bge-reranker-base     # or "none" to skip reranking
# NCCI_MIN_RELEVANCE=0.30                   # calibrated with: python eval/run_eval.py (safe range 0.10-0.70)
# NCCI_TOP_K=6

# To use Azure OpenAI instead, set these (model names above become deployment names):
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
