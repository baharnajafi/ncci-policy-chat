# Copy to .streamlit/secrets.toml for a local test, or paste into the platform's secret
# settings (Streamlit Community Cloud: App settings -> Secrets). Never commit secrets.toml.
OPENAI_API_KEY = "sk-..."

# Optional: a shared password for the hosted app, and a per-session question limit,
# so a public link cannot spend the key freely.
APP_PASSWORD = "choose-a-password"
NCCI_MAX_QUESTIONS = "25"

# Lighter reranker for small containers: same eval quality here (MRR 0.97 vs 0.96),
# about 650 MB of memory instead of 1150 MB. See docs/DEPLOY.md.
NCCI_RERANKER = "cross-encoder/ms-marco-MiniLM-L-6-v2"
NCCI_MIN_RELEVANCE = "0.30"
